{
  "name": "@mokanadev/design-system",
  "version": "0.3.0",
  "description": "MOK Design System: tokens semánticos, componentes React y temas por producto.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRMJ-Labs/mokana-design-system.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.website.config.ts",
    "start": "vite --config vite.website.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite.website.config.ts",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "build:lib": "vite build && tsc -p tsconfig.build.json",
    "test": "npm run build && npm run test:ui",
    "test:ui": "node --test tests/*.test.mjs",
    "test:checks": "node scripts/run-checks.mjs",
    "verify": "npm run docs:check && npm run typecheck && npm run build && npm run build:lib && npm run test:ui && npm run test:checks && npm run test:consumer",
    "tokens": "node scripts/build-tokens.mjs",
    "preview": "vite preview --config vite.website.config.ts",
    "test:website": "node scripts/check-website.mjs",
    "prepublishOnly": "npm run typecheck && npm run build:lib",
    "check:links": "node scripts/check-links.mjs",
    "consumer:prepare": "node scripts/prepare-consumer.mjs",
    "consumer:dev": "npm --prefix examples/consumer run dev",
    "test:consumer": "npm run consumer:prepare && node scripts/test-consumer.mjs && node scripts/test-palettes.mjs",
    "docs:api": "node scripts/build-api-reference.mjs",
    "docs:check": "node scripts/build-api-reference.mjs --check"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mokana.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": "./tokens.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "files": [
    "dist",
    "public",
    "tokens.json",
    "figma-map.json",
    "THIRD_PARTY_NOTICES.md",
    "docs/integration.md"
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "1.66.0"
  }
}
