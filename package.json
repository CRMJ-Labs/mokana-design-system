{
  "name": "@mokana/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node --test tests/*.test.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "preview": "node scripts/serve.mjs",
    "chromatic": "chromatic"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mokana.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": "./tokens.json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "chromatic": "18.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "files": [
    "dist",
    "public",
    "tokens.json",
    "figma-map.json"
  ]
}
